{
  "name": "mirae",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "smoke": "node scripts/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mirae/db db:generate",
    "db:migrate": "pnpm --filter @mirae/db db:migrate",
    "db:studio": "pnpm --filter @mirae/db db:studio",
    "db:check": "node --env-file=.env packages/db/src/check.ts",
    "db:seed": "pnpm --filter @mirae/db db:seed",
    "beta:code:create": "node --env-file=.env scripts/beta-code.mjs create",
    "beta:code:list": "node --env-file=.env scripts/beta-code.mjs list",
    "beta:code:revoke": "node --env-file=.env scripts/beta-code.mjs revoke"
  },
  "devDependencies": {
    "@mirae/config": "workspace:*",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "turbo": "2.10.9",
    "typescript": "6.0.3"
  }
}
