# Mirae — environment variables.
# Copy to `.env` (used by tooling: drizzle-kit, seed scripts) and never commit real values.
# The Cloudflare Worker itself reads runtime secrets from apps/api/.dev.vars in
# local dev (same keys) and from `wrangler secret put` in production.

# --- Database (Sprint 3) ---
# Neon dev-branch connection string (serverless driver, HTTP). See docs/DATABASE.md.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/mirae?sslmode=require"

# --- Auth (Sprint 3, Better Auth) ---
# Generate a strong random secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=""
# Base URL the app is served from (dev default below).
BETTER_AUTH_URL="http://localhost:5173"

# --- Email (Sprint 9, Resend) ---
RESEND_API_KEY=""

# --- Closed beta gate (Sprint 23) ---
# Salts the SHA-256 hash of invitation codes (codes are never stored in
# plaintext). Set a strong random value in production, e.g. `openssl rand -hex 32`.
# Changing it invalidates all existing codes.
BETA_CODE_PEPPER=""
# Gate is ON unless set to exactly "false". At public launch, set to "false"
# to open signup to everyone.
CLOSED_BETA_ENABLED="true"

# --- Billing (post-MVP, Stripe subscription) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Files (Sprint 8, Cloudflare R2) ---
# R2 is bound to the Worker via wrangler.toml bindings (not env vars). See
# apps/api/wrangler.toml when the bucket is added.
